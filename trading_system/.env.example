# Angel One SmartAPI Credentials
API_KEY=your_smartapi_key_here
CLIENT_CODE=your_client_code_here
PIN=your_mpin_here
TOTP_SECRET=your_totp_secret_here

# Trading System Configuration
MODE=paper                  # 'paper' or 'live'
PORTFOLIO_EQUITY=100000.0   # Total trading capital in INR
RISK_PERCENT=1.0            # 1R risk percentage per trade (e.g. 1.0% = 0.01)
MAX_CAPITAL_PER_TRADE=50000.0
MAX_DAILY_LOSS=1500.0       # Max daily loss kill switch in INR
MAX_OPEN_POSITIONS=4        # Maximum simultaneous open positions
MAX_DAILY_TRADES=8          # Max trades per trading day

# Time Boundaries (IST format HH:MM)
WARMUP_END_TIME=09:30
NO_ENTRY_AFTER=15:00
SQUARE_OFF_TIME=15:15

# Watchlist (comma-separated tradingsymbols without -EQ)
WATCHLIST=RELIANCE,TCS,HDFCBANK,INFY,ICICIBANK,SBIN,BHARTIARTL,KOTAKBANK,LT,AXISBANK,ASIANPAINT,MARUTI,TITAN,BAJFINANCE,TRENT
